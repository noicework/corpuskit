{"_t": 27400, "operation": 0, "seqid": 11, "step": {"module": "basic_ask", "title": "Searching Fisheries research", "agent_path": "context/ctx-fisheries", "timeit": 18.5, "input_nuclia_tokens": 2210, "output_nuclia_tokens": 340}, "context": {"id": "ctx-fisheries", "agent_id": "drv-fisheries", "agent": "fisheries", "source": "Fisheries research", "question": "How are warmer waters changing disease and pest pressure in fisheries and aquaculture?", "chunks": [{"chunk_id": "res-fish-0412/f/file/0-218", "title": "Summer mortality in farmed oysters: a ten-year review", "source": "upload", "text": "Mortality events in farmed oysters clustered in the weeks after water temperature stayed above the seasonal average for more than ten days. Leases in shallow, sheltered estuaries were affected first and recovered last.", "labels": ["/l/topic/climate"], "url": "https://example.org/fish/res-fish-0412.pdf", "origin_url": "https://example.org/fish/res-fish-0412.pdf", "origin_agent": null}, {"chunk_id": "res-fish-0377/f/file/700-872", "title": "Pathogen surveillance in temperate abalone farms", "source": "upload", "text": "Routine sampling found the pathogen load in tank water rose with temperature, and outbreaks followed the warmest fortnights of each summer across the three seasons studied.", "labels": ["/l/topic/climate"], "url": "https://example.org/fish/res-fish-0377.pdf", "origin_url": "https://example.org/fish/res-fish-0377.pdf", "origin_agent": null}, {"chunk_id": "res-fish-0519/f/file/1400-1587", "title": "Temperature triggers for shellfish movement controls", "source": "upload", "text": "Movement controls between growing areas are now triggered by water temperature thresholds rather than by calendar date, which brought controls forward by two to three weeks in warm years.", "labels": ["/l/topic/climate"], "url": "https://example.org/fish/res-fish-0519.pdf", "origin_url": "https://example.org/fish/res-fish-0519.pdf", "origin_agent": null}], "summary": "Warmer water is linked to shellfish disease outbreaks."}}
