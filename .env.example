# Progress Agentic RAG - account level (used by `deno task provision` only)
ARAG_ZONE=aws-ap-southeast-2-1
ARAG_ACCOUNT=your-account-id
ARAG_NUA_KEY=your-account-nua-key

# Per-tenant knowledge box bindings (written automatically by `deno task provision`)
# ARAG_KB_GRAINS=...
# ARAG_KB_GRAINS_TOKEN=...
# ARAG_KB_MARINE=...
# ARAG_KB_MARINE_TOKEN=...

# Break-glass admin passcode: grants owner for one request that sends it in
# the x-admin-passcode header. It works only while ADMIN_BREAK_GLASS is exactly
# true, in every environment; there is no default passcode. Set both only while
# you need the emergency path, and use a long random value.
# ADMIN_PASSCODE=choose-a-long-random-value
# ADMIN_BREAK_GLASS=true

# Microsoft Entra ID / Microsoft 365 sign-in (Cloudflare production). The
# redirect URI must exactly match the Web redirect URI on the app registration.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# ENTRA_REDIRECT_URI=https://corpuskit.org/auth/callback
# ENTRA_ADMIN_EMAILS=admin@example.com
# SESSION_SECRET=generate-at-least-32-random-bytes

# Optional hosting automation. Generate at least 32 random bytes and encode as
# unpadded base64url. Used only with Authorization: Operator <key>, never Bearer.
# The same settings work in the local server and the Cloudflare Worker.
# OPERATOR_API_KEY=
# OPERATOR_ID=operator

# Optional external sign-in, alongside Entra or on its own (local server and Worker).
# Configure both issuer and Ed25519 public JWK to enable the handoff. Never use the private key.
# SESSION_SECRET above is required in production; local development without it ends sessions
# on restart. WORKER_NAME is the assertion audience. Replay identifiers persist in SQLite.
# WORKER_NAME=corpuskit
# EXTERNAL_LOGIN_ISSUER=https://identity.example
# EXTERNAL_LOGIN_JWK='{"kty":"OKP","crv":"Ed25519","x":"<public-key-base64url>"}'
# EXTERNAL_LOGIN_NAME=Continue with your organisation account
# Set the issuer start URL to show the external sign-in button. Otherwise it stays hidden,
# so an external-only deployment needs it. The button adds returnTo=<portal path>.
# EXTERNAL_LOGIN_START_URL=https://identity.example/start

# Optional automatic portal subdomains. Create a dedicated narrowly scoped
# Cloudflare API token - do not reuse the deployment token.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DOMAINS_TOKEN=

# Port the API server listens on. Defaults to 8787 if unset.
# PORT=8787

# Directory for the small app-side JSON/JSONL stores (insights, sessions,
# watches, sources, investigations, suggestions). Defaults to ./data.
# In production (Dockerfile/fly.toml) this is set to /app/data, a mounted
# Fly volume.
# DATA_DIR=./data

# Individual store file paths. Each defaults to a file under DATA_DIR /
# ./data and only needs setting if you want a store somewhere else (this is
# how fly.toml points them at the mounted volume in production).
# BINDINGS_PATH=./data/bindings.json
# Encrypt stored knowledge-box tokens. Base64 of 32 random bytes; required for
# new or replaced bindings on Cloudflare. Keep the same key across restarts.
# BINDING_KEY=
# Also seal tokens already stored as plaintext, at the next start. Set it only
# once a release that understands sealed tokens has been verified; see
# docs/HOSTING.md. The Cloudflare secret upload task never sends it.
# BINDING_KEY_MIGRATE=true
# Runtime platform domain, also set as a Worker var. Defaults to corpuskit.org.
# PLATFORM_DOMAIN=corpuskit.org
# TENANTS_PATH=./data/tenants.json
# KG_PROPOSALS_PATH=./data/kg-proposals.json
# BRANDING_PATH=./data/branding

# Rate limits for the paid-LLM routes (ask, generate, summarize, subqueries,
# verdicts, synthesise) and for POST /api/ask-estate, which fans one request
# across every tenant and counts once per portal it reaches. Requests per
# minute; set any of them to 0 to disable it. Admin routes (passcode-gated) are
# never rate limited. See docs/HOSTING.md, "Client addresses and rate limits".
# Per browser, inside its client address:
# RATE_LIMIT_ASK_PER_MIN=20
# Per client address (defaults to five times the per-browser limit):
# RATE_LIMIT_ASK_PER_MIN_IP=100
# Anonymous asks on each portal, from every address together:
# RATE_LIMIT_ANON_PORTAL_ASK_PER_MIN=30
# Cross-portal asks per client address:
# RATE_LIMIT_ESTATE_PER_MIN=6
# Answer ratings (POST /api/t/:slug/feedback) per minute per client IP and portal; 0 disables.
# RATE_LIMIT_FEEDBACK_PER_MIN=30

# Local server only: how many reverse proxies in front of it append to
# x-forwarded-for. Unset or 0 keys every client on its TCP peer address and
# ignores x-forwarded-for. Never set it higher than the proxies you run.
# TRUST_PROXY_HOPS=1

# Build identifier surfaced by GET /api/health as "version". Not required for
# local dev (defaults to "dev"); set by CI/deploy tooling if you want each
# deployed image to report its commit SHA.
# BUILD_SHA=
